# Copy this file to `.env` and fill it in. `.env` is git-ignored.
#
# IMPORTANT: every EXPO_PUBLIC_* variable is compiled into the app bundle and can
# be read by anyone who has the app. Only put values here that you are fine with
# being public, and set spending limits on the provider side.

# ── Chat assistant (Groq) ─────────────────────────────────
EXPO_PUBLIC_GROQ_API_KEY=
# Optional: point the chat at your own proxy (which holds the real key) so the key
# never ships inside the app. When set, EXPO_PUBLIC_GROQ_API_KEY is not required.
# EXPO_PUBLIC_CHAT_API_URL=https://your-proxy.example.com/chat
# EXPO_PUBLIC_CHAT_MODEL=openai/gpt-oss-120b

# ── Firebase (Firestore REST) ─────────────────────────────
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# Document id under users/ that holds your birthdays (default: eshaan)
# EXPO_PUBLIC_CLOUD_USER_ID=eshaan

# ── EmailJS ───────────────────────────────────────────────
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=

# Never put the Firebase *admin* key in this file or anywhere in the repo.
# The GitHub Action reads it from the FIREBASE_SERVICE_ACCOUNT_KEY repository secret.
